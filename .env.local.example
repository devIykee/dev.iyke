# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
# Public URL + anon key are safe to expose to the browser (read-only via RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: SERVER-ONLY. Bypasses RLS. Used exclusively by /api/admin/*
# write routes. Never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin gate
# The passcode typed into the /admin login form.
ADMIN_PASSCODE=change-me-to-a-strong-passphrase
# Secret used to sign the admin session JWT (any long random string).
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
